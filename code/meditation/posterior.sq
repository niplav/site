@name("p(cessation | h hr/day for d days)")
pCess(h: [0.1, 16], d: [1, 365]) = {
	lh = log(h / 8.0)
	ll = log(d / 10.0)
	lam = exp(posterior.a + posterior.u +
		posterior.b_d * log(1 + 2780.5 / 1000) +
		posterior.b_h * lh + posterior.b_L * ll +
		posterior.b_hL * lh * ll)
	1 - exp(-lam)
}
